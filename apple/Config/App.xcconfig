// Build settings shared by every configuration of the MyApp target.
//
// API keys come from Secrets.xcconfig, which is git-ignored. Copy
// Secrets.example.xcconfig to Secrets.xcconfig and fill in your own keys.
// Without it the build still succeeds; odds and YouTube features are disabled.
ODDS_API_KEY =
YOUTUBE_API_KEY =

// Premium gating. YES unlocks every feature and never talks to StoreKit (the state while
// in-app purchases are hidden). Set to NO to ship the paywall; scripts/check-release-config.sh
// reports this flag, and fails the build when STRICT_RELEASE_CONFIG=1.
BANNER_UNLOCK_ALL_FEATURES = YES

#include? "Secrets.xcconfig"

// CarPlay Audio requires Apple approval and a matching provisioning profile.
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = Config/CarPlay.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*] = Config/CarPlay.entitlements

#include? "ProviderDefaults.xcconfig"

// Release gate. Set BANNER_KMP_ENABLED=YES when validating the migrated NHL feed.
BANNER_KMP_ENABLED = NO
BANNER_KMP_DEFINE_YES = BANNER_SHARED_FOUNDATION
BANNER_KMP_LINK_YES = -framework BannerFoundation
// Preserve iOS 27 APIs on newer SDKs and allow the reference 26.4 toolchain to compile.
BANNER_SDK_FLAGS[sdk=iphone*26*] = BANNER_NO_CARPLAY_MINIPLAYER BANNER_NO_RESERVED_REGIONS
BANNER_SDK_FLAGS[sdk=iphone*27.0*] = BANNER_NO_RESERVED_REGIONS
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(BANNER_SDK_FLAGS) $(BANNER_KMP_DEFINE_$(BANNER_KMP_ENABLED))
OTHER_LDFLAGS = $(inherited) $(BANNER_KMP_LINK_$(BANNER_KMP_ENABLED))
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(BUILT_PRODUCTS_DIR)"
BANNER_SCRIPT_SANDBOX_NO = YES
BANNER_SCRIPT_SANDBOX_YES = NO
ENABLE_USER_SCRIPT_SANDBOXING = $(BANNER_SCRIPT_SANDBOX_$(BANNER_KMP_ENABLED))
