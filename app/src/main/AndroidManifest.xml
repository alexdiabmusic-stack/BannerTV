<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <application
        android:name=".StadiaTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner_raster"
        android:icon="@drawable/app_icon_raster"
        android:label="BannerTV"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.StadiaTV">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner_raster"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTask"
            android:icon="@drawable/app_icon_raster"
            android:label="BannerTV"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
